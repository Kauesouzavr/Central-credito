# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (painel do Supabase -> Project Settings -> API).
# O .env.local NUNCA deve ser enviado ao GitHub (já está no .gitignore).

# Project URL
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave "service_role" (NÃO é a "anon"). Fica só no servidor, nunca é
# enviada ao navegador. Trate como senha.
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service-role-aqui

# Chave "anon" / "public" (Fase 10: login). Usada só no servidor (login,
# middleware), nunca é enviada ao navegador neste projeto — mas ela é
# pública por natureza (é a mesma que ficaria exposta num app cliente),
# diferente da service_role.
SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
