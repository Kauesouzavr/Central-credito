# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (painel do Supabase -> Project Settings -> API).
# O .env.local NUNCA deve ser enviado ao GitHub (já está no .gitignore).

# Project URL
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave "service_role" (NÃO é a "anon"). Fica só no servidor, nunca é
# enviada ao navegador. Trate como senha.
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service-role-aqui

# Chave "anon" / "public" (Fase 10: login). Usada só no servidor (login,
# middleware), nunca é enviada ao navegador neste projeto — mas ela é
# pública por natureza (é a mesma que ficaria exposta num app cliente),
# diferente da service_role.
SUPABASE_ANON_KEY=cole-a-chave-anon-aqui

# Somente demo (demonstração pública, branch `demo`). Valores só no .env.local
# e no painel da Vercel (Production) do projeto DA DEMO, nunca no repositório.
# O SUPABASE_URL / chaves acima têm que ser os do projeto Supabase da demo
# (conta separada), jamais os do sistema real. Nada disso usa NEXT_PUBLIC_.
#
# Liga tudo da demo (aviso, botão "Explorar a demonstração", faixa, rota de
# reset). Sem isso, nada da demo existe. Só o valor exato 1 liga.
DEMO_MODE=1
# Trecho do SUPABASE_URL antes de ".supabase.co". A trava (lib/demo-guard.js)
# só deixa apagar/recriar dados se o host for exatamente este ref + ".supabase.co".
DEMO_SUPABASE_REF=ref-do-projeto-demo
# Usuário visitante (criado em Authentication > Users, com auto-confirm). O
# login acontece no servidor; a senha nunca vai pro navegador.
DEMO_USER_EMAIL=visitante@exemplo.invalid
DEMO_USER_PASSWORD=senha-forte-do-visitante
# Segredo do cron diário (/api/demo/reset). 32+ caracteres aleatórios. A Vercel
# manda como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=string-aleatoria-de-32-ou-mais-caracteres
